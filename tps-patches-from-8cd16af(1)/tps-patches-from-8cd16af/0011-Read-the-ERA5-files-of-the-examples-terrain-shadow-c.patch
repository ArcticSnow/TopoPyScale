             return None
-        if not (_same(out.latitude.values, lat) and _same(out.longitude.values, lon)):
+        out = _select_nodes(out, lat, lon, levels)
+        if out is None or not (_same(out.latitude.values, lat) and _same(out.longitude.values, lon)):
             return None
